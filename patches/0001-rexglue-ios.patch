diff --git a/src/ui/app_background.cpp b/src/ui/app_background.cpp
new file mode 100644
index 0000000..4bbcb11
--- /dev/null
+++ b/src/ui/app_background.cpp
@@ -0,0 +1,68 @@
+/**
+ * @file        ui/app_background.cpp
+ * @brief       Holding GPU work while an iOS app is in the background
+ */
+
+#include <rex/ui/app_background.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+
+#include <SDL3/SDL_init.h>
+
+#include <rex/logging.h>
+
+namespace rex::ui {
+
+namespace {
+std::atomic<bool> g_in_background{false};
+std::mutex g_mutex;
+std::condition_variable g_resumed;
+}  // namespace
+
+void SetAppInBackground(bool in_background) {
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (g_in_background.load(std::memory_order_relaxed) == in_background) {
+      return;
+    }
+    g_in_background.store(in_background, std::memory_order_release);
+  }
+  REXLOG_INFO("App {}: GPU work {}", in_background ? "going to the background" : "back",
+              in_background ? "held" : "resumed");
+  if (!in_background) {
+    g_resumed.notify_all();
+  }
+}
+
+bool IsAppInBackground() {
+  return g_in_background.load(std::memory_order_acquire);
+}
+
+void WaitWhileAppInBackground() {
+  if (!g_in_background.load(std::memory_order_acquire) || SDL_IsMainThread()) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(g_mutex);
+  g_resumed.wait(lock, [] { return !g_in_background.load(std::memory_order_acquire); });
+}
+
+std::atomic<unsigned long long> g_gpu_calls[kGpuCallKinds];
+std::atomic<unsigned long long> g_gpu_nanoseconds[kGpuCallKinds];
+
+void AddGpuCall(int kind, unsigned long long nanoseconds) {
+  g_gpu_calls[kind].fetch_add(1, std::memory_order_relaxed);
+  g_gpu_nanoseconds[kind].fetch_add(nanoseconds, std::memory_order_relaxed);
+}
+
+GpuCallStats GetGpuCallStats() {
+  GpuCallStats stats;
+  for (int i = 0; i < kGpuCallKinds; ++i) {
+    stats.calls[i] = g_gpu_calls[i].load(std::memory_order_relaxed);
+    stats.nanoseconds[i] = g_gpu_nanoseconds[i].load(std::memory_order_relaxed);
+  }
+  return stats;
+}
+
+}  // namespace rex::ui
