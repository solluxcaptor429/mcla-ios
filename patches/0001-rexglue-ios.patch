+bool VulkanCommandProcessor::HoistReadOverlaps(uint32_t start, uint32_t end) const {
+  // The first interval that ends after the start.
+  auto it = std::upper_bound(
+      hoist_read_intervals_.cbegin(), hoist_read_intervals_.cend(), start,
+      [](uint32_t value, const std::pair<uint32_t, uint32_t>& interval) {
+        return value < interval.second;
+      });
+  return it != hoist_read_intervals_.cend() && it->first < end;
