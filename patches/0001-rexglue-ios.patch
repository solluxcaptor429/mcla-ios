+bool SharedMemory::IsAnyPageHotInRange(uint32_t start, uint32_t length) const {
+  if (!length || start >= kBufferSize) {
+    return false;
+  }
+  const uint32_t now_ms = uint32_t(rex::chrono::Clock::QueryHostUptimeMillis());
+  if (!AnyPageHot(now_ms)) {
+    return false;
+  }
+  length = std::min(length, kBufferSize - start);
+  const uint32_t page_first = start >> page_size_log2_;
+  const uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    if (IsPageHot(page, now_ms)) {
+      return true;
+    }
+  }
+  return false;
