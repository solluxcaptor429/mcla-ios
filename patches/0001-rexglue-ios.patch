+void SharedMemory::DropHotShadow(uint32_t page_first, uint32_t page_last) {
+  if (hot_shadow_.empty()) {
+    return;
+  }
+  if (page_last - page_first >= hot_shadow_.size()) {
+    for (auto it = hot_shadow_.begin(); it != hot_shadow_.end();) {
+      if (it->first >= page_first && it->first <= page_last) {
+        it = hot_shadow_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+    return;
+  }
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    hot_shadow_.erase(page);
+  }
+}
