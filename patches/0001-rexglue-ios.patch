+void SharedMemory::AppendChangedHotBytes(uint32_t byte_start, uint32_t byte_end) {
+  // A cap on the copies kept (64 MiB of them): start over rather than grow.
+  if (hot_shadow_.size() > 16384) {
+    hot_shadow_.clear();
+  }
+  // The run of changed bytes being gathered, to 4 bytes (vertex data is in
+  // words): what precedes the first byte that differs and follows the last is
+  // not uploaded, so that an upload does not touch what another draw read
+  // right next to it.
+  uint32_t run_start = UINT32_MAX;
+  uint32_t run_end = 0;
+  HotShadowPage* shadow = nullptr;
+  uint32_t shadow_page = UINT32_MAX;
+  for (uint32_t address = byte_start; address < byte_end; address += 64) {
+    const uint32_t page = address >> 12;
+    if (page != shadow_page) {
+      shadow_page = page;
+      shadow = &hot_shadow_[page];
+      if (!shadow->data) {
+        shadow->data.reset(new uint8_t[4096]);
+        shadow->valid_blocks = 0;
+      }
+    }
+    const uint32_t block = (address & 4095) >> 6;
+    const uint64_t block_bit = uint64_t(1) << block;
+    uint8_t* const kept = shadow->data.get() + (block << 6);
+    const uint8_t* const guest = memory_.TranslatePhysical(address);
+    uint32_t first_different = 0;
+    uint32_t last_different = 63;
+    if (shadow->valid_blocks & block_bit) {
+      while (first_different < 64 && kept[first_different] == guest[first_different]) {
+        ++first_different;
+      }
+      if (first_different == 64) {
+        // The block is as it was uploaded.
+        if (run_start != UINT32_MAX) {
+          hot_byte_ranges_.emplace_back(run_start, run_end - run_start);
+          run_start = UINT32_MAX;
+        }
+        continue;
+      }
+      while (last_different > first_different && kept[last_different] == guest[last_different]) {
+        --last_different;
+      }
+    }
+    std::memcpy(kept, guest, 64);
+    shadow->valid_blocks |= block_bit;
+    const uint32_t changed_start = address + (first_different & ~uint32_t(3));
+    const uint32_t changed_end = address + ((last_different + 4) & ~uint32_t(3));
+    if (run_start != UINT32_MAX && first_different >= 4) {
+      // Unchanged bytes between the last block's and this one's: two runs.
+      hot_byte_ranges_.emplace_back(run_start, run_end - run_start);
+      run_start = UINT32_MAX;
+    }
+    if (run_start == UINT32_MAX) {
+      run_start = changed_start;
+    }
+    run_end = changed_end;
+    if (last_different < 60) {
+      // Unchanged bytes at the block's end: the run ends here.
+      hot_byte_ranges_.emplace_back(run_start, run_end - run_start);
+      run_start = UINT32_MAX;
+    }
+  }
+  if (run_start != UINT32_MAX) {
+    hot_byte_ranges_.emplace_back(run_start, run_end - run_start);
+  }
+}
