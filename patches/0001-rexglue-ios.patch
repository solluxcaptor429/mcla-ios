diff --git a/include/rex/ui/app_background.h b/include/rex/ui/app_background.h
new file mode 100644
index 0000000..0c7618c
--- /dev/null
+++ b/include/rex/ui/app_background.h
@@ -0,0 +1,54 @@
+/**
+ * @file        rex/ui/app_background.h
+ * @brief       Holding GPU work while an iOS app is in the background
+ *
+ * iOS refuses GPU work from an app in the background: a Metal command buffer
+ * committed then fails with kIOGPUCommandBufferCallbackErrorBackgroundExecution-
+ * NotPermitted, and Vulkan (MoltenVK) reports the device lost, which ends the
+ * game. The windowed app context closes this gate when the app is about to go
+ * to the background and opens it when the app is back; the threads that submit
+ * GPU work wait at it. The main (UI) thread never waits (it delivers the event
+ * that opens the gate); it does not paint while the gate is closed instead.
+ *
+ * On every other platform the gate is never closed.
+ */
+
+#pragma once
+
+namespace rex::ui {
+
+void SetAppInBackground(bool in_background);
+bool IsAppInBackground();
+// Blocks the calling thread while the app is in the background. Returns at
+// once on the main thread.
+void WaitWhileAppInBackground();
+
+// What the gated calls cost, for a performance log: calls and nanoseconds in
+// vkQueueSubmit (0), vkQueuePresentKHR (1) and vkAcquireNextImageKHR (2) so far,
+// and calls only of what is recorded into command buffers: render passes begun
+// (3), draws (4), buffer copies (5), buffer-to-image copies (6), compute
+// dispatches (7), pipeline barriers (8) and pipeline binds (9); and why the
+// render passes of the guest's drawing were ended: a shared memory upload that
+// could not go before the pass (10), the texture cache (11), the render target
+// cache's resolves and dumps (12), an occlusion query's begin or end (13), the
+// end of a submission (14), another render target or a transfer (15),
+// anything else that asked for it (16), barriers pending at a draw (17).
+constexpr int kGpuCallKinds = 18;
+struct GpuCallStats {
+  unsigned long long calls[kGpuCallKinds];
+  unsigned long long nanoseconds[kGpuCallKinds];
+};
+void AddGpuCall(int kind, unsigned long long nanoseconds);
+
+// How far the creation of the stored pipelines at start has got, for a front
+// end to show (total 0: not started; done == total: finished).
+void SetStartupProgress(unsigned long long done, unsigned long long total);
+void GetStartupProgress(unsigned long long* done, unsigned long long* total);
+
+// Pad buttons (X_INPUT_GAMEPAD_* bits) held on the app's own on-screen
+// controls: the input driver adds them to the state of the pad it reports.
+void SetExtraPadButtons(unsigned buttons);
+unsigned GetExtraPadButtons();
+GpuCallStats GetGpuCallStats();
+
+}  // namespace rex::ui
diff --git a/src/core/exception_handler_posix.cpp b/src/core/exception_handler_posix.cpp
index 8b1c76a..4048927 100644
--- a/src/core/exception_handler_posix.cpp
+++ b/src/core/exception_handler_posix.cpp
@@ -31,8 +31,70 @@
 
 #include <ucontext.h>
 
+#if REX_PLATFORM_IOS
+#include <cstdio>
+
+// dladdr, declared here: this file asks for an XSI feature level (for
+// <ucontext.h>), under which <dlfcn.h> leaves it and Dl_info out.
+extern "C" {
+struct RexDlInfo {
+  const char* dli_fname;
+  void* dli_fbase;
+  const char* dli_sname;
+  void* dli_saddr;
+};
+int dladdr(const void* address, RexDlInfo* info);
+}
+#endif
+
 namespace rex::arch {
 
+#if REX_PLATFORM_IOS
+namespace {
+// A fault nobody handled is the game (or the runtime) crashing. Returning from
+// the signal handler would run the faulting instruction again, for ever: the
+// app froze and filled its log instead of ending. Say where it was, with the
+// functions' names (recompiled guest functions are sub_<guest address>), and
+// let the default action end the process.
+void ReportUnhandledFault(int signal_number, const void* fault_address, uint64_t pc, uint64_t fp,
+                          uint64_t lr) {
+  std::printf("[mcla-crash] signal %d at address %p, pc 0x%llx\n", signal_number, fault_address,
+              static_cast<unsigned long long>(pc));
+  uint64_t frames[40];
+  int count = 0;
+  frames[count++] = pc;
+  frames[count++] = lr;
+  while (fp && !(fp & 7) && count < 40) {
+    const uint64_t* record = reinterpret_cast<const uint64_t*>(fp);
+    const uint64_t next = record[0];
+    const uint64_t return_address = record[1] & 0x00007FFFFFFFFFFFull;
+    if (!return_address) {
+      break;
+    }
+    frames[count++] = return_address;
+    if (next <= fp) {
+      break;
+    }
+    fp = next;
+  }
+  for (int i = 0; i < count; ++i) {
+    RexDlInfo info;
+    if (dladdr(reinterpret_cast<void*>(frames[i]), &info) && info.dli_fname) {
+      const char* image = std::strrchr(info.dli_fname, '/');
+      image = image ? image + 1 : info.dli_fname;
+      std::printf("[mcla-crash]   %2d %s %s+0x%llx\n", i, image, info.dli_sname ? info.dli_sname : "?",
+                  static_cast<unsigned long long>(
+                      frames[i] - reinterpret_cast<uint64_t>(info.dli_sname ? info.dli_saddr
+                                                                            : info.dli_fbase)));
+    } else {
+      std::printf("[mcla-crash]   %2d 0x%llx\n", i, static_cast<unsigned long long>(frames[i]));
+    }
+  }
+  std::fflush(stdout);
+}
+}  // namespace
+#endif
+
 bool signal_handlers_installed_ = false;
 struct sigaction original_sigill_handler_;
 struct sigaction original_sigsegv_handler_;
@@ -417,6 +479,12 @@ static void ExceptionHandlerCallback(int signal_number, siginfo_t* signal_info,
       return;
     }
   }
+#if REX_PLATFORM_IOS
+  // The default action first: a fault while reporting then ends the process too.
+  signal(signal_number, SIG_DFL);
+  ReportUnhandledFault(signal_number, signal_info->si_addr, thread_context.pc, thread_context.x[29],
+                       thread_context.x[30]);
+#endif
 }
 
 void ExceptionHandler::Install(Handler fn, void* data) {
