+          regs[XE_GPU_REG_VGT_DMA_BASE] & ~uint32_t(is_32bit ? 3 : 1);
+      const uint32_t size_bytes = count * (is_32bit ? 4 : 2);
+      if (base >= SharedMemory::kBufferSize || size_bytes > SharedMemory::kBufferSize - base) {
+        return false;
+      }
+      const xenos::Endian endian = regs.Get<reg::VGT_DMA_SIZE>().swap_mode;
+      const bool reset_enabled = regs.Get<reg::PA_SU_SC_MODE_CNTL>().multi_prim_ib_ena != 0;
+      const uint32_t reset_index =
+          regs[XE_GPU_REG_VGT_MULTI_PRIM_IB_RESET_INDX] & (is_32bit ? UINT32_MAX : UINT32_C(0xFFFF));
+      const uint8_t* indices = memory_->TranslatePhysical(base);
+      uint32_t found_first = UINT32_MAX, found_last = 0;
+      bool any = false;
+      for (uint32_t i = 0; i < count; ++i) {
+        uint32_t index;
+        if (is_32bit) {
+          uint32_t raw;
+          std::memcpy(&raw, indices + size_t(i) * 4, 4);
+          index = xenos::GpuSwap(raw, endian);
+        } else {
+          uint16_t raw;
