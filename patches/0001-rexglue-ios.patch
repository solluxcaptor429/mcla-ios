+template <typename Functions>
+void InstallBackgroundGate(Functions& dfn) {
+#define REX_IOS_COUNT(name)                                \
+  if (dfn.vk##name && dfn.vk##name != &Counted##name) {    \
+    g_real_vk##name = dfn.vk##name;                        \
+    dfn.vk##name = &Counted##name;                         \
+  }
+  REX_IOS_COUNT(CmdBeginRenderPass)
+  REX_IOS_COUNT(CmdBeginRendering)
+  REX_IOS_COUNT(CmdDraw)
+  REX_IOS_COUNT(CmdDrawIndexed)
+  REX_IOS_COUNT(CmdCopyBuffer)
+  REX_IOS_COUNT(CmdCopyBufferToImage)
+  REX_IOS_COUNT(CmdDispatch)
+  REX_IOS_COUNT(CmdPipelineBarrier)
+  REX_IOS_COUNT(CmdBindPipeline)
+#undef REX_IOS_COUNT
+  if (dfn.vkQueueSubmit && dfn.vkQueueSubmit != &GatedQueueSubmit) {
+    g_real_vkQueueSubmit = dfn.vkQueueSubmit;
+    dfn.vkQueueSubmit = &GatedQueueSubmit;
+  }
+  if (dfn.vkQueuePresentKHR && dfn.vkQueuePresentKHR != &GatedQueuePresentKHR) {
+    g_real_vkQueuePresentKHR = dfn.vkQueuePresentKHR;
+    dfn.vkQueuePresentKHR = &GatedQueuePresentKHR;
+  }
+  if (dfn.vkAcquireNextImageKHR && dfn.vkAcquireNextImageKHR != &GatedAcquireNextImageKHR) {
+    g_real_vkAcquireNextImageKHR = dfn.vkAcquireNextImageKHR;
+    dfn.vkAcquireNextImageKHR = &GatedAcquireNextImageKHR;
+  }
+}
