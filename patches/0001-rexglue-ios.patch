+  switch (vgt_draw_initiator.source_select) {
+    case xenos::SourceSelect::kAutoIndex:
+      raw_first = 0;
+      raw_last = count - 1;
+      break;
+    case xenos::SourceSelect::kDMA: {
+      // The guest's index buffer, as guest memory has it now (what goes to
+      // the host is uploaded from the same bytes).
+      if (count > 65536) {
+        return false;
+      }
