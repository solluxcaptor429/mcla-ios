diff --git a/include/rex/ui/app_background.h b/include/rex/ui/app_background.h
new file mode 100644
index 0000000..c08877c
--- /dev/null
+++ b/include/rex/ui/app_background.h
@@ -0,0 +1,39 @@
+/**
+ * @file        rex/ui/app_background.h
+ * @brief       Holding GPU work while an iOS app is in the background
+ *
+ * iOS refuses GPU work from an app in the background: a Metal command buffer
+ * committed then fails with kIOGPUCommandBufferCallbackErrorBackgroundExecution-
+ * NotPermitted, and Vulkan (MoltenVK) reports the device lost, which ends the
+ * game. The windowed app context closes this gate when the app is about to go
+ * to the background and opens it when the app is back; the threads that submit
+ * GPU work wait at it. The main (UI) thread never waits (it delivers the event
+ * that opens the gate); it does not paint while the gate is closed instead.
+ *
+ * On every other platform the gate is never closed.
+ */
+
+#pragma once
+
+namespace rex::ui {
+
+void SetAppInBackground(bool in_background);
+bool IsAppInBackground();
+// Blocks the calling thread while the app is in the background. Returns at
+// once on the main thread.
+void WaitWhileAppInBackground();
+
+// What the gated calls cost, for a performance log: calls and nanoseconds in
+// vkQueueSubmit (0), vkQueuePresentKHR (1) and vkAcquireNextImageKHR (2) so far,
+// and calls only of what is recorded into command buffers: render passes begun
+// (3), draws (4), buffer copies (5), buffer-to-image copies (6), compute
+// dispatches (7), pipeline barriers (8) and pipeline binds (9).
+constexpr int kGpuCallKinds = 10;
+struct GpuCallStats {
+  unsigned long long calls[kGpuCallKinds];
+  unsigned long long nanoseconds[kGpuCallKinds];
+};
+void AddGpuCall(int kind, unsigned long long nanoseconds);
+GpuCallStats GetGpuCallStats();
+
+}  // namespace rex::ui
