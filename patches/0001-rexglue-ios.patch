+
+void VulkanCommandProcessor::HoistReadInsert(uint32_t start, uint32_t end) {
+  if (start >= end) {
+    return;
+  }
+  // The first interval that ends at the start or after it: it and those that
+  // follow while they begin at the end or before it become one with the new.
+  auto first = std::lower_bound(
+      hoist_read_intervals_.begin(), hoist_read_intervals_.end(), start,
+      [](const std::pair<uint32_t, uint32_t>& interval, uint32_t value) {
+        return interval.second < value;
+      });
+  auto last = first;
+  while (last != hoist_read_intervals_.end() && last->first <= end) {
+    start = std::min(start, last->first);
+    end = std::max(end, last->second);
+    ++last;
+  }
+  if (first == last) {
+    hoist_read_intervals_.insert(first, std::make_pair(start, end));
+  } else {
+    *first = std::make_pair(start, end);
+    hoist_read_intervals_.erase(first + 1, last);
+  }
+}
